# ===== FAST LOCAL (15 min on your PC) =====
# انسخ إلى .env وعدّل المفتاح

RUN_MINUTES=15
FAST_WORKERS=32
FAST_PER_QUERY=60
MAX_TOTAL_COMPANIES=30000
REQUIRE_CONTACT=1
FAST_ENRICH_WEBSITE=0
EXPORT_DIR=./exports
SQLITE_PATH=./exports/saudi_leads_fast.db

# ضروري للوصول لأرقام كبيرة بسرعة:
GOOGLE_PLACES_API_KEY=
