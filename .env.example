# Database
DATABASE_URL=postgresql://user:password@localhost:5432/saudi_leads
# Or MySQL: mysql+pymysql://user:password@localhost:3306/saudi_leads

# Scraper settings
RUN_HOURS=50
SCRAPE_DELAY_MIN=2
SCRAPE_DELAY_MAX=5
EXPORT_INTERVAL_MINUTES=30
MAX_COMPANIES_PER_QUERY=50

# Export path (on Render use /tmp or persistent disk)
EXPORT_DIR=./exports

# Optional: Google Places API (more reliable than scraping Maps)
GOOGLE_PLACES_API_KEY=

# Proxy (optional, recommended for long runs)
HTTP_PROXY=
HTTPS_PROXY=

# Soft limit — stop gracefully after N companies if set
MAX_TOTAL_COMPANIES=0

# Keep Render awake (minutes between self-ping)
KEEPALIVE_MINUTES=10
