# Local / Render defaults — SQLite on disk, 24h, anti-sleep
RUN_HOURS=24
KEEPALIVE_MINUTES=3
EXPORT_DIR=./exports
SQLITE_PATH=./exports/saudi_leads.db
SCRAPE_DELAY_MIN=1
SCRAPE_DELAY_MAX=3
EXPORT_INTERVAL_MINUTES=15
MAX_COMPANIES_PER_QUERY=40
REQUIRE_CONTACT=1
BACKFILL_BATCH=40
MAX_TOTAL_COMPANIES=40000
GOOGLE_PLACES_API_KEY=
